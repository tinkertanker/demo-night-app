{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-night-app",
  "main": ".open-next/worker.js",
  "account_id": "b8b1032c61d9475cd00229c74db7ec72",
  "routes": [
    {
      "pattern": "demo-night.tk.sg",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "demo-night-app"
    }
  ],
  // Run next to the Neon database (AWS Singapore) whoever is calling
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "observability": {
    "enabled": true
  },
  // Secrets (set with `wrangler secret put`): DATABASE_URL,
  // DATABASE_URL_NON_POOLING, NEXTAUTH_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET
  "vars": {
    "NEXTAUTH_URL": "https://demo-night.tk.sg",
    "NEXT_PUBLIC_URL": "https://demo-night.tk.sg",
    "NEXT_PUBLIC_BASE_URL": "https://demo-night.tk.sg",
    "NEXT_PUBLIC_NODE_ENV": "production"
  }
}
