#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is missing; run .agents/setup before resuming this orb." >&2
  exit 1
fi

amp orb services ensure

for attempt in {1..16}; do
  if sudo docker info >/dev/null 2>&1; then
    sudo docker compose up -d
    exit 0
  fi
  sleep 0.5
done

echo "Docker did not become ready while resuming the orb." >&2
exit 1
